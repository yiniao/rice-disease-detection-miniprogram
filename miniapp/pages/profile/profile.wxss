.profile-page {
  display: grid;
  gap: 20rpx;
}

.profile-hero {
  padding: 22rpx;
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2e7d32;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.profile-meta {
  flex: 1;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #111827;
}

.profile-subtitle {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.profile-panel {
  padding: 22rpx;
  display: grid;
  gap: 14rpx;
}

.profile-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.info-grid {
  display: grid;
  gap: 12rpx;
}

.form-field,
.info-field {
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
}

.info-label {
  color: #6b7280;
  font-size: 22rpx;
}

.info-value {
  margin-top: 6rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.profile-actions {
  display: grid;
  gap: 12rpx;
  margin-top: 6rpx;
}

.save-btn,
.logout-btn {
  width: 100%;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

@media screen and (max-width: 750rpx) {
  .profile-top {
    align-items: flex-start;
  }
}
