.history-page {
  display: grid;
  gap: 20rpx;
  min-width: 0;
}

.hero-card {
  padding: 22rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 22rpx;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
}

.hero-copy {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.8;
}

.history-list {
  display: grid;
  gap: 16rpx;
}

.history-card {
  display: grid;
  grid-template-columns: minmax(0, 28%) minmax(0, 1fr);
  gap: 16rpx;
  align-items: start;
  min-width: 0;
}

.history-thumb-wrap {
  width: 100%;
  max-width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.history-thumb {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f6f9f4;
}

.history-thumb--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: #f6f9f4;
}

.history-content {
  display: grid;
  gap: 10rpx;
  min-width: 0;
}

.history-chip-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.history-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.category-chip,
.status-chip {
  display: inline-flex;
  width: fit-content;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.category-chip {
  background: #ecfdf3;
  color: #15803d;
}

.status-chip {
  background: #e8f5e9;
  color: #2e7d32;
}

.history-meta {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.6;
}

.history-action-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  margin-top: 16rpx;
}

.history-action-btn {
  width: 100%;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 4rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 64rpx;
  box-sizing: border-box;
}

.history-action-btn--primary {
  background: #2e7d32;
  color: #ffffff;
}

.history-action-btn--secondary {
  background: #e8f5e9;
  color: #2e7d32;
}

.history-action-btn--danger {
  background: #ef4444;
  color: #ffffff;
}

.pagination-bar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  width: 100%;
  margin-top: 20rpx;
}

.pagination-btn {
  width: 100%;
  min-width: 0;
  height: 60rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 22rpx;
  line-height: 60rpx;
}

.pagination-info {
  min-width: 0;
  max-width: 180rpx;
  color: #6b7280;
  font-size: 22rpx;
  text-align: center;
  white-space: nowrap;
}

.empty-panel .empty-state {
  padding: 48rpx 0;
}

@media screen and (max-width: 750rpx) {
  .history-card {
    grid-template-columns: 1fr;
  }

  .history-thumb-wrap {
    width: 100%;
    max-width: none;
    height: 320rpx;
  }
}
