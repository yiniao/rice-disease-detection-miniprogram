# 复制为 .env 后按需填写。请勿把填写后的 .env 提交到仓库(已在 .gitignore 中排除)。

# ===== Django =====
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ENABLE_WEB_FRONTEND=True

# 初始管理员(执行 migrate 时创建;留空则跳过,改用 python manage.py createsuperuser)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_NICKNAME=管理员

# ===== 数据库 =====
# 是否启用 MySQL 由 MYSQL_HOST / MYSQL_ADDRESS 是否为空决定:
# 两者都留空 → 自动回退到项目目录下的 SQLite(适合本地开发)。
MYSQL_DATABASE=rice_guard
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
# 部分云托管平台用 MYSQL_ADDRESS 提供 host(形如 host:port),与 MYSQL_HOST 填一个即可
MYSQL_ADDRESS=
MYSQL_PORT=3306

# ===== 微信小程序 / 云开发 =====
WECHAT_APPID=
WECHAT_SECRET=
# 小程序端另有部署私有配置,见 miniapp/utils/config.js 顶部说明

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 模型推理 =====
# mock: 不加载模型,返回固定结果(便于联调);onnx: 使用 ONNXRuntime 推理
MODEL_BACKEND=onnx
DEFAULT_MODEL_NAME=rice-pest-detector
DEFAULT_MODEL_VERSION=v1
DEFAULT_MODEL_CLASS_NAMES=healthy,brown_spot,leaf_scald,leaf_blast,bacterial_leaf_blight,leaf_smut,narrow_brown_spot,not_leaf
# 容器内路径示例:/app/0712_null/weights/best.onnx;留空则自动查找项目下的 0712_null/weights
ULTRALYTICS_WEIGHTS_PATH=
ULTRALYTICS_DEVICE=cpu
# 可视化中文渲染所用的字体文件路径,留空则用系统默认字体
VIS_FONT_PATH=
